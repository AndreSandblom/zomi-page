---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroTour from '../components/HeroTour.astro';
import SeasonSlider from '../components/SeasonSlider.astro';
import { servicesData } from '../data/services';
---

<BaseLayout 
  title="ZoMi Media – AI-videorundturer & Säsongsförvandling för Fastighetsmäklare"
  description="Förvandla vanliga mäklarbilder till cinematiska AI-videorundturer och skapa magiska säsongsbyten från snö till sommarsol. 100% fotorealistiskt."
>
  <!-- 1. Huvudtjänst i fokus: Direkt AI-rundtur från stillbilder -->
  <HeroTour />

  <!-- 2. Nästa tjänst: Säsongsbyte & Miljöförvandling med interaktiv slider -->
  <SeasonSlider />

  <!-- 3. Kort översikt av tjänster & Direktlänk till Tjänster / Kontakt -->
  <section class="home-services-teaser section">
    <div class="container">
      <div class="section-header">
        <div class="section-badge">
          <span>Kort Tjänsteöversikt</span>
        </div>
        <h2 class="section-title">
          Allt ni behöver för att <span class="gradient-text">dominera bostadsmarknaden</span>
        </h2>
        <p class="section-subtitle">
          Ett komplett paket av AI-drivna medietjänster skapade specifikt för mäklare och fastighetsbyråer som vill spara tid och sälja snabbare.
        </p>
      </div>

      <div class="teaser-grid">
        {servicesData.map((service) => (
          <div class="teaser-card glass-panel">
            <div class="teaser-icon">
              {service.icon === 'video' && '🎥'}
              {service.icon === 'sun' && '☀️'}
              {service.icon === 'home' && '🛋️'}
            </div>
            <span class="teaser-badge">{service.badge}</span>
            <h3 class="teaser-title">{service.title}</h3>
            <p class="teaser-desc">{service.shortDesc}</p>
            <a href={`/tjanster#${service.id}`} class="teaser-link">
              <span>Läs mer om tjänsten</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
          </div>
        ))}
      </div>

      <!-- CTA Box directing to /tjanster and contact -->
      <div class="cta-teaser-box glass-panel">
        <div class="cta-teaser-content">
          <h3 class="cta-box-title">Vill ni veta mer eller testa med en egen bild?</h3>
          <p class="cta-box-desc">
            Läs mer om våra fullständiga specifikationer, priser och process under fliken Tjänster, eller skicka in ett testobjekt direkt.
          </p>
        </div>
        <div class="cta-box-buttons">
          <a href="/tjanster" class="btn btn-primary btn-lg">
            <span>Se alla tjänster &amp; Kontakta oss</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
          <a href="/portfolio" class="btn btn-secondary btn-lg">
            Utforska Portfolio
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-services-teaser {
    background: radial-gradient(circle at 50% 100%, rgba(56, 189, 248, 0.03) 0%, transparent 60%);
  }

  .teaser-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
    margin-bottom: var(--space-16);
  }

  .teaser-card {
    padding: var(--space-8);
    border-radius: var(--radius-xl);
    display: flex;
    flex-direction: column;
    transition: all var(--transition-base);
  }

  .teaser-card:hover {
    transform: translateY(-4px);
    border-color: rgba(229, 179, 100, 0.4);
    box-shadow: var(--shadow-md);
  }

  .teaser-icon {
    font-size: 32px;
    margin-bottom: var(--space-4);
    line-height: 1;
  }

  .teaser-badge {
    align-self: flex-start;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--accent-gold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-3);
  }

  .teaser-title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
    color: var(--text-heading);
  }

  .teaser-desc {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-6);
  }

  .teaser-link {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent-gold);
    transition: gap var(--transition-fast);
  }

  .teaser-link:hover {
    gap: var(--space-3);
  }

  /* Bottom Big CTA Box */
  .cta-teaser-box {
    padding: var(--space-10) var(--space-12);
    border-radius: var(--radius-xl);
    border: 1px solid rgba(229, 179, 100, 0.35);
    background: linear-gradient(135deg, rgba(24, 27, 35, 0.95) 0%, rgba(35, 30, 20, 0.7) 100%);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
  }

  .cta-teaser-content {
    max-width: 600px;
  }

  .cta-box-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-2);
    color: var(--text-heading);
  }

  .cta-box-desc {
    font-size: var(--text-base);
    color: var(--text-muted);
  }

  .cta-box-buttons {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 280px;
  }

  @media (max-width: 960px) {
    .teaser-grid {
      grid-template-columns: 1fr;
    }

    .cta-teaser-box {
      flex-direction: column;
      text-align: center;
      padding: var(--space-8);
    }

    .cta-box-buttons {
      width: 100%;
    }
  }
</style>
