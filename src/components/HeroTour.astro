---
---

<section class="hero-tour-section" id="hero-tour">
  <div class="container">
    <!-- Hero Header -->
    <div class="hero-header">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        <span>Morgondagens Mäklarpresentationer</span>
      </div>
      <h1 class="hero-title">
        Från vanliga mäklarbilder till <span class="gradient-text">levande videorundturer</span>
      </h1>
      <p class="hero-subtitle">
        Vi förvandlar era stillbilder till cinematiska AI-videorundturer med mjuka kamerarörelser och perfekt ljussättning. Inga dyra filmteam på plats – bara era vanliga bilder och vår AI.
      </p>
    </div>

    <!-- The Instant Tour Showcase Player -->
    <div class="showcase-wrapper">
      <div class="showcase-card glass-panel" id="hero-player-card">
        <!-- Showcase Top Bar Controls -->
        <div class="showcase-topbar">
          <div class="status-indicator">
            <span class="rec-dot"></span>
            <span class="rec-text" id="mode-label">AI-VIDEORUNDTUR 4K</span>
          </div>

          <!-- Format Switcher: 16:9 vs 9:16 -->
          <div class="format-switcher">
            <button class="format-btn active" data-format="16/9" id="btn-format-169" title="16:9 Webb & Hemnet">
              <svg width="16" height="12" viewBox="0 0 16 12" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="1" width="14" height="10" rx="1.5"/></svg>
              <span>16:9 Webb / Hemnet</span>
            </button>
            <button class="format-btn" data-format="9/16" id="btn-format-916" title="9:16 Reels & TikTok">
              <svg width="10" height="16" viewBox="0 0 10 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="1" width="8" height="14" rx="1.5"/></svg>
              <span>9:16 Reels / TikTok</span>
            </button>
          </div>

          <!-- View Mode Toggle: Stillbild vs AI-Video -->
          <div class="view-toggle">
            <button class="toggle-mode-btn" id="btn-mode-still">Stillbild</button>
            <button class="toggle-mode-btn active" id="btn-mode-video">AI-Rundtur</button>
          </div>
        </div>

        <!-- Visual Screen / Stage Area -->
        <div class="player-stage aspect-169" id="player-stage">
          <!-- 16:9 Landscape Scene -->
          <div class="scene-container scene-169 active" id="scene-169">
            <!-- Still image layer -->
            <img 
              src="/assets/images/penthouse-still.svg" 
              alt="Stillbild av sekelskiftesvåning" 
              class="scene-img img-still"
              id="img-still-169"
            />
            <!-- Dynamic video tour layer -->
            <div class="video-tour-layer" id="tour-layer-169">
              <img 
                src="/assets/images/penthouse-tour.svg" 
                alt="AI-genererad videorundtur" 
                class="scene-img img-tour"
              />
              <div class="camera-sweep-overlay"></div>
            </div>
          </div>

          <!-- 9:16 Portrait Scene -->
          <div class="scene-container scene-916" id="scene-916">
            <img 
              src="/assets/images/kitchen-still.svg" 
              alt="Stillbild kök 9:16" 
              class="scene-img img-still"
              id="img-still-916"
            />
            <div class="video-tour-layer" id="tour-layer-916">
              <img 
                src="/assets/images/kitchen-video.svg" 
                alt="AI-video kök 9:16" 
                class="scene-img img-tour"
              />
              <div class="camera-sweep-overlay"></div>
            </div>
          </div>

          <!-- Telemetry & Camera HUD Overlay -->
          <div class="camera-hud">
            <div class="hud-top-left">
              <span class="hud-tag">OBJECT: ÖSTERMALM #402</span>
              <span class="hud-tag hud-camera-mode">CAM: DOLLY SMOOTH</span>
            </div>
            <div class="hud-top-right">
              <span class="hud-tag">AI-RENDER: 60 FPS</span>
            </div>
            <div class="hud-center-crosshair">
              <div class="crosshair-h"></div>
              <div class="crosshair-v"></div>
            </div>
            <div class="hud-bottom-info">
              <span class="hud-subtle">Källmaterial: 1 st standard JPG mäklarbild</span>
            </div>
          </div>

          <!-- Play / Live Pulse Indicator -->
          <div class="live-action-badge">
            <button class="action-toggle-play" id="btn-play-pause" aria-label="Spela / Pausa simulering">
              <svg class="icon-pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
              <svg class="icon-play" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="display:none;"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              <span id="play-text">AI Rundtur Spelas</span>
            </button>
          </div>
        </div>

        <!-- Showcase Footbar with Stats & Quick Actions -->
        <div class="showcase-footbar">
          <div class="highlight-item">
            <span class="hl-value">0 kr</span>
            <span class="hl-label">I filmteamkostnader</span>
          </div>
          <div class="highlight-item">
            <span class="hl-value">24h</span>
            <span class="hl-label">Snabb leveranstid</span>
          </div>
          <div class="highlight-item">
            <span class="hl-value">+350%</span>
            <span class="hl-label">Fler klick på Hemnet &amp; Reels</span>
          </div>
          <div class="footbar-cta">
            <a href="/tjanster#kontakt" class="btn btn-primary btn-sm">
              Skicka testbild gratis
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Hero Interactive Player Logic
  const modeStillBtn = document.getElementById('btn-mode-still');
  const modeVideoBtn = document.getElementById('btn-mode-video');
  const btnFormat169 = document.getElementById('btn-format-169');
  const btnFormat916 = document.getElementById('btn-format-916');
  const playerStage = document.getElementById('player-stage');
  const scene169 = document.getElementById('scene-169');
  const scene916 = document.getElementById('scene-916');
  const tourLayer169 = document.getElementById('tour-layer-169');
  const tourLayer916 = document.getElementById('tour-layer-916');
  const modeLabel = document.getElementById('mode-label');
  const btnPlayPause = document.getElementById('btn-play-pause');
  const playText = document.getElementById('play-text');
  const iconPause = btnPlayPause?.querySelector('.icon-pause') as HTMLElement;
  const iconPlay = btnPlayPause?.querySelector('.icon-play') as HTMLElement;

  let isPlaying = true;

  function updateMode(toVideo: boolean) {
    if (toVideo) {
      modeVideoBtn?.classList.add('active');
      modeStillBtn?.classList.remove('active');
      tourLayer169?.classList.remove('hide-tour');
      tourLayer916?.classList.remove('hide-tour');
      if (modeLabel) modeLabel.textContent = 'AI-VIDEORUNDTUR 4K';
      if (btnPlayPause) btnPlayPause.style.display = 'inline-flex';
    } else {
      modeStillBtn?.classList.add('active');
      modeVideoBtn?.classList.remove('active');
      tourLayer169?.classList.add('hide-tour');
      tourLayer916?.classList.add('hide-tour');
      if (modeLabel) modeLabel.textContent = 'ORIGINAL STILLBILD (FOTO)';
      if (btnPlayPause) btnPlayPause.style.display = 'none';
    }
  }

  modeStillBtn?.addEventListener('click', () => updateMode(false));
  modeVideoBtn?.addEventListener('click', () => updateMode(true));

  // Format toggle
  btnFormat169?.addEventListener('click', () => {
    btnFormat169.classList.add('active');
    btnFormat916?.classList.remove('active');
    playerStage?.classList.remove('aspect-916');
    playerStage?.classList.add('aspect-169');
    scene169?.classList.add('active');
    scene916?.classList.remove('active');
  });

  btnFormat916?.addEventListener('click', () => {
    btnFormat916.classList.add('active');
    btnFormat169?.classList.remove('active');
    playerStage?.classList.remove('aspect-169');
    playerStage?.classList.add('aspect-916');
    scene916?.classList.add('active');
    scene169?.classList.remove('active');
  });

  // Play / Pause simulation
  btnPlayPause?.addEventListener('click', () => {
    isPlaying = !isPlaying;
    const currentTourLayer = playerStage?.classList.contains('aspect-916') ? tourLayer916 : tourLayer169;
    
    if (isPlaying) {
      currentTourLayer?.classList.remove('paused');
      if (playText) playText.textContent = 'AI Rundtur Spelas';
      if (iconPause) iconPause.style.display = 'block';
      if (iconPlay) iconPlay.style.display = 'none';
    } else {
      currentTourLayer?.classList.add('paused');
      if (playText) playText.textContent = 'Pausad';
      if (iconPause) iconPause.style.display = 'none';
      if (iconPlay) iconPlay.style.display = 'block';
    }
  });
</script>

<style>
  .hero-tour-section {
    padding-top: var(--space-12);
    padding-bottom: var(--space-20);
    position: relative;
    overflow: hidden;
  }

  .hero-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto var(--space-10) auto;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-4);
    background: rgba(229, 179, 100, 0.1);
    border: 1px solid rgba(229, 179, 100, 0.25);
    color: var(--accent-gold);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-4);
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    background-color: var(--accent-gold);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--accent-gold);
    animation: pulseGlow 2s infinite ease-in-out;
  }

  @keyframes pulseGlow {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.85); }
  }

  .hero-title {
    margin-bottom: var(--space-5);
  }

  .hero-subtitle {
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--text-muted);
  }

  /* Showcase Card */
  .showcase-wrapper {
    max-width: 1040px;
    margin: 0 auto;
  }

  .showcase-card {
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg), 0 0 40px rgba(0, 0, 0, 0.5);
    border: 1px solid var(--border-medium);
  }

  .showcase-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-5);
    background: rgba(14, 16, 22, 0.95);
    border-bottom: 1px solid var(--border-subtle);
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .rec-dot {
    width: 9px;
    height: 9px;
    background-color: #ef4444;
    border-radius: 50%;
    animation: blink 1.2s infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .rec-text {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent-gold);
  }

  /* Format buttons */
  .format-switcher {
    display: flex;
    background: rgba(255, 255, 255, 0.05);
    padding: 3px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
  }

  .format-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .format-btn.active {
    background: var(--bg-tertiary);
    color: var(--text-heading);
    box-shadow: var(--shadow-sm);
  }

  /* View toggle */
  .view-toggle {
    display: flex;
    background: rgba(255, 255, 255, 0.05);
    padding: 3px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
  }

  .toggle-mode-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 5px 14px;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .toggle-mode-btn.active {
    background: linear-gradient(135deg, var(--accent-gold) 0%, #d49e4b 100%);
    color: #090a0d;
    box-shadow: 0 2px 8px rgba(229, 179, 100, 0.3);
  }

  /* Player Stage */
  .player-stage {
    position: relative;
    width: 100%;
    background: #000000;
    overflow: hidden;
    transition: aspect-ratio var(--transition-smooth);
  }

  .player-stage.aspect-169 {
    aspect-ratio: 16 / 9;
    max-height: 560px;
  }

  .player-stage.aspect-916 {
    aspect-ratio: 9 / 16;
    max-height: 580px;
    margin: 0 auto;
  }

  .scene-container {
    position: absolute;
    inset: 0;
    display: none;
    width: 100%;
    height: 100%;
  }

  .scene-container.active {
    display: block;
  }

  .scene-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Tour layer with animated camera simulation */
  .video-tour-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 1;
    transition: opacity var(--transition-base);
    animation: cameraDollyPan 10s ease-in-out infinite alternate;
    transform-origin: center center;
  }

  .video-tour-layer.hide-tour {
    opacity: 0;
    pointer-events: none;
  }

  .video-tour-layer.paused {
    animation-play-state: paused;
  }

  @keyframes cameraDollyPan {
    0% {
      transform: scale(1) translate(0%, 0%);
    }
    35% {
      transform: scale(1.05) translate(-1.5%, -1%);
    }
    70% {
      transform: scale(1.08) translate(1.5%, -0.5%);
    }
    100% {
      transform: scale(1.03) translate(0%, 1%);
    }
  }

  .camera-sweep-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.05) 50%,
      transparent 100%
    );
    pointer-events: none;
    animation: sweepLight 6s linear infinite;
  }

  @keyframes sweepLight {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }

  /* HUD Overlay */
  .camera-hud {
    position: absolute;
    inset: 0;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-4);
  }

  .hud-top-left, .hud-top-right {
    display: flex;
    gap: var(--space-2);
  }

  .hud-top-right {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
  }

  .hud-tag {
    font-family: monospace;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.8);
    background: rgba(0, 0, 0, 0.55);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .hud-camera-mode {
    color: var(--accent-gold);
    border-color: rgba(229, 179, 100, 0.3);
  }

  .hud-center-crosshair {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 30px;
    height: 30px;
    opacity: 0.3;
  }

  .crosshair-h {
    position: absolute;
    top: 14px;
    left: 0;
    width: 30px;
    height: 2px;
    background: #ffffff;
  }

  .crosshair-v {
    position: absolute;
    top: 0;
    left: 14px;
    width: 2px;
    height: 30px;
    background: #ffffff;
  }

  .hud-bottom-info {
    position: absolute;
    bottom: var(--space-4);
    left: var(--space-4);
  }

  .hud-subtle {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.7);
    background: rgba(0, 0, 0, 0.6);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
  }

  /* Live Action Badge button */
  .live-action-badge {
    position: absolute;
    bottom: var(--space-4);
    right: var(--space-4);
  }

  .action-toggle-play {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(9, 10, 13, 0.85);
    border: 1px solid var(--accent-gold);
    color: var(--accent-gold);
    padding: 6px 14px;
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
    backdrop-filter: blur(10px);
    transition: all var(--transition-fast);
  }

  .action-toggle-play:hover {
    background: var(--accent-gold);
    color: #090a0d;
  }

  /* Footbar */
  .showcase-footbar {
    display: grid;
    grid-template-columns: repeat(3, 1fr) auto;
    align-items: center;
    padding: var(--space-4) var(--space-6);
    background: rgba(14, 16, 22, 0.95);
    border-top: 1px solid var(--border-subtle);
    gap: var(--space-4);
  }

  .highlight-item {
    display: flex;
    flex-direction: column;
  }

  .hl-value {
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--accent-gold);
    line-height: 1.1;
  }

  .hl-label {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  @media (max-width: 860px) {
    .showcase-topbar {
      flex-direction: column;
      align-items: flex-start;
    }

    .showcase-footbar {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-4);
    }

    .footbar-cta {
      grid-column: span 2;
    }

    .footbar-cta .btn {
      width: 100%;
    }
  }

  @media (max-width: 520px) {
    .showcase-footbar {
      grid-template-columns: 1fr;
    }

    .footbar-cta {
      grid-column: span 1;
    }
  }
</style>
