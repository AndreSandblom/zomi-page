---
---

<section class="hero-cinematic-section" id="hero">
  <!-- Cinematic Background Graphic Layer (Strong on the right, fading into dark on the left) -->
  <div class="hero-bg-canvas" aria-hidden="true">
    <div class="hero-bg-image"></div>
    <div class="hero-ambient-fire-glow"></div>
    <div class="hero-overlay-gradient"></div>
  </div>

  <div class="container hero-container">
    <div class="hero-content">
      <!-- Badge / Pill -->
      <div class="hero-pill-badge">
        <span class="pill-dot"></span>
        <span class="pill-text">FILMISKA UPPLEVELSER AV PLATSER</span>
      </div>

      <!-- Main Headline -->
      <h1 class="hero-headline">
        Från <span class="highlight-underline">stillbilder</span><br />
        till platser som<br />
        <span class="gold-gradient-glow">känns levande.</span>
      </h1>

      <!-- Description Subtitle -->
      <p class="hero-lead">
        Vi förvandlar professionella bilder av bostäder, hotell och miljöer till filmiska upplevelser – utan en ny fotografering eller videoinspelning på plats.
      </p>

      <!-- Action Buttons -->
      <div class="hero-actions">
        <a href="/portfolio" class="btn btn-hero-primary">
          Se våra projekt
        </a>
        <a href="/tjanster#kontakt" class="btn btn-hero-secondary">
          <span>Testa med era bilder</span>
          <svg class="arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  .hero-cinematic-section {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
    overflow: hidden;
    background-color: #090a0d;
  }

  /* Cinematic Background Graphic Layer */
  .hero-bg-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  .hero-bg-image {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
    background-image: url('/assets/images/hero-sunset-lounge1.png');
    background-position: right center;
    background-size: cover;
    background-repeat: no-repeat;
    opacity: 0.95;
    transform: scale(1.01);
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Subtle ambient warmth glow */
  .hero-ambient-fire-glow {
    position: absolute;
    top: 50%;
    right: 12%;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(245, 158, 11, 0.15) 0%, rgba(220, 38, 38, 0.08) 45%, transparent 75%);
    filter: blur(40px);
    animation: fireFlicker 3.5s ease-in-out infinite alternate;
  }

  @keyframes fireFlicker {
    0% {
      opacity: 0.5;
      transform: scale(0.96) translate(0, 0);
    }
    50% {
      opacity: 0.8;
      transform: scale(1.04) translate(4px, -3px);
    }
    100% {
      opacity: 0.65;
      transform: scale(1) translate(-2px, 2px);
    }
  }

  /* Smooth Left-to-Right and Bottom gradient mask for soft landing */
  .hero-overlay-gradient {
    position: absolute;
    inset: 0;
    background: 
      linear-gradient(90deg, #090a0d 0%, #090a0d 25%, rgba(9, 10, 13, 0.9) 45%, rgba(9, 10, 13, 0.45) 70%, rgba(9, 10, 13, 0.05) 100%),
      linear-gradient(180deg, rgba(9, 10, 13, 0.3) 0%, transparent 65%, #090a0d 100%);
  }

  /* Container & Content Layout */
  .hero-container {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .hero-content {
    max-width: 600px;
    margin-left: clamp(1.25rem, 5vw, 4.5rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  /* Pill Badge */
  .hero-pill-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.45rem 1.15rem;
    background: rgba(22, 25, 33, 0.85);
    border: 1px solid rgba(229, 179, 100, 0.3);
    border-radius: var(--radius-full);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    margin-bottom: var(--space-6);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
  }

  .pill-dot {
    width: 8px;
    height: 8px;
    background: #e5b364;
    border-radius: 50%;
    box-shadow: 0 0 10px #e5b364;
    animation: badgePulse 2s infinite ease-in-out;
  }

  @keyframes badgePulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(0.85); }
  }

  .pill-text {
    color: #e5b364;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  /* Headline - Softer font-weight */
  .hero-headline {
    font-size: clamp(2.3rem, 4.4vw, 3.85rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin-bottom: var(--space-6);
  }

  /* Underline effect on "stillbilder" matching reference image */
  .highlight-underline {
    position: relative;
    display: inline-block;
  }

  .highlight-underline::after {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, #ffffff 0%, rgba(255, 255, 255, 0.7) 100%);
    border-radius: var(--radius-full);
    box-shadow: 0 0 12px rgba(255, 255, 255, 0.6);
  }

  /* Golden gradient on "känns levande." */
  .gold-gradient-glow {
    background: linear-gradient(135deg, #fcd34d 0%, #e5b364 50%, #d49539 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 2px 14px rgba(229, 179, 100, 0.25));
  }

  /* Lead text */
  .hero-lead {
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    line-height: 1.65;
    color: #a1a8b8;
    margin-bottom: var(--space-8);
    max-width: 540px;
  }

  /* Buttons */
  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-10);
    flex-wrap: wrap;
  }

  /* Solid Warm Gold Button (matching "Se våra projekt") */
  .btn-hero-primary {
    background: #e5b364;
    color: #090a0d;
    font-size: var(--text-sm);
    font-weight: 700;
    padding: 0.9rem 1.9rem;
    border-radius: var(--radius-full);
    border: 1px solid #e5b364;
    transition: all var(--transition-base);
    box-shadow: 0 4px 18px rgba(229, 179, 100, 0.35);
  }

  .btn-hero-primary:hover {
    background: #f0c37c;
    border-color: #f0c37c;
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(229, 179, 100, 0.5);
  }

  /* Glass / Outline Dark Button (matching "Testa med era bilder →") */
  .btn-hero-secondary {
    background: rgba(14, 16, 22, 0.7);
    color: #ffffff;
    font-size: var(--text-sm);
    font-weight: 600;
    padding: 0.9rem 1.8rem;
    border-radius: var(--radius-full);
    border: 1px solid rgba(229, 179, 100, 0.45);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    transition: all var(--transition-base);
  }

  .btn-hero-secondary:hover {
    background: rgba(24, 27, 35, 0.9);
    border-color: #e5b364;
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(229, 179, 100, 0.25);
  }

  .arrow-icon {
    transition: transform var(--transition-fast);
  }

  .btn-hero-secondary:hover .arrow-icon {
    transform: translateX(4px);
  }

  /* Sectors List */
  .hero-sectors-list {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: #64748b;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .sector-item {
    color: #8392a8;
  }

  .sector-bullet {
    color: #e5b364;
    opacity: 0.6;
    font-size: 10px;
  }

  @media (max-width: 960px) {
    .hero-cinematic-section {
      min-height: auto;
      padding-top: var(--space-10);
      padding-bottom: var(--space-12);
    }

    .hero-overlay-gradient {
      background: 
        linear-gradient(180deg, rgba(9, 10, 13, 0.75) 0%, rgba(9, 10, 13, 0.92) 100%),
        linear-gradient(90deg, #090a0d 0%, rgba(9, 10, 13, 0.7) 100%);
    }

    .hero-content {
      max-width: 100%;
    }
  }

  @media (max-width: 540px) {
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .hero-actions .btn {
      width: 100%;
      justify-content: center;
    }

    .hero-sectors-list {
      flex-wrap: wrap;
    }
  }
</style>
