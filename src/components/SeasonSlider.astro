---
---

<section class="season-section" id="season-showcase">
  <div class="container">
    <div class="section-header">
      <div class="section-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        <span>Tjänst 2: Miljö- &amp; Säsongsförvandling</span>
      </div>
      <h2 class="section-title">
        Sälj sommaridyllen – <span class="gradient-text">oavsett årstid</span>
      </h2>
      <p class="section-subtitle">
        Bostadsförsäljningar ska inte behöva vänta på rätt väder. Dra i reglaget nedan för att se hur vi förvandlar snö och grå himmel till strålande sommarsol eller exklusivt skymningsljus.
      </p>
    </div>

    <!-- Preset Selector Tabs -->
    <div class="slider-preset-tabs">
      <button class="preset-tab active" data-preset="villa">
        <span class="preset-icon">❄️ ➔ ☀️</span>
        <span>Snö till Sommarsol</span>
      </button>
      <button class="preset-tab" data-preset="twilight">
        <span class="preset-icon">☁️ ➔ 🌅</span>
        <span>Dag till Golden Hour</span>
      </button>
      <button class="preset-tab" data-preset="staging">
        <span class="preset-icon">📦 ➔ 🛋️</span>
        <span>Virtuell Homestaging</span>
      </button>
    </div>

    <!-- The Interactive Slider Stage -->
    <div class="slider-wrapper glass-panel">
      <div class="slider-container" id="season-slider-container">
        <!-- Background Layer: AFTER (Summer / Twilight / Staged) -->
        <div class="slider-layer layer-after">
          <img 
            src="/assets/images/villa-summer.svg" 
            alt="Efter: AI-Sommar" 
            class="slider-img" 
            id="img-after"
          />
          <div class="layer-badge badge-after" id="badge-after-text">
            <span>☀️ EFTER: AI-SOMMAR</span>
          </div>
        </div>

        <!-- Foreground Layer: BEFORE (Winter / Day / Empty) -->
        <div class="slider-layer layer-before" id="slider-before-layer">
          <img 
            src="/assets/images/villa-winter.svg" 
            alt="Före: Vinter" 
            class="slider-img" 
            id="img-before"
          />
          <div class="layer-badge badge-before" id="badge-before-text">
            <span>❄️ FÖRE: SNÖ &amp; VINTER</span>
          </div>
        </div>

        <!-- Draggable Handle Bar -->
        <div class="slider-handle" id="slider-handle">
          <div class="handle-line"></div>
          <div class="handle-button" aria-label="Dra reglage för att jämföra före och efter">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
              <polyline points="9 18 3 12 9 6" style="display:none;"></polyline>
            </svg>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </div>
          <div class="handle-line"></div>
        </div>

        <!-- Touch/Drag Overlay helper hint -->
        <div class="drag-hint" id="drag-hint">
          <span>Dra i reglaget för att jämföra</span>
        </div>
      </div>

      <!-- Features summary below slider -->
      <div class="slider-footer-features">
        <div class="sf-feature">
          <div class="sf-icon">🌱</div>
          <div>
            <h4 class="sf-title">Fotorealistisk Grönska</h4>
            <p class="sf-desc">Gräsmattor, träd och rabatter i full sommarskrud.</p>
          </div>
        </div>
        <div class="sf-feature">
          <div class="sf-icon">🌤️</div>
          <div>
            <h4 class="sf-title">Perfekt Ljussättning</h4>
            <p class="sf-desc">Blå himmel och naturliga solskuggor anpassade efter husets arkitektur.</p>
          </div>
        </div>
        <div class="sf-feature">
          <div class="sf-icon">🏊</div>
          <div>
            <h4 class="sf-title">Pool &amp; Utemiljö</h4>
            <p class="sf-desc">Väck liv i altaner, terrasser och poolområden året runt.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Season Slider Drag Logic
  const container = document.getElementById('season-slider-container');
  const beforeLayer = document.getElementById('slider-before-layer');
  const handle = document.getElementById('slider-handle');
  const dragHint = document.getElementById('drag-hint');

  const imgBefore = document.getElementById('img-before') as HTMLImageElement;
  const imgAfter = document.getElementById('img-after') as HTMLImageElement;
  const badgeBefore = document.getElementById('badge-before-text');
  const badgeAfter = document.getElementById('badge-after-text');

  const presetTabs = document.querySelectorAll('.preset-tab');

  const presets = {
    villa: {
      before: '/assets/images/villa-winter.svg',
      after: '/assets/images/villa-summer.svg',
      beforeLabel: '❄️ FÖRE: SNÖ & VINTER',
      afterLabel: '☀️ EFTER: AI-SOMMAR'
    },
    twilight: {
      before: '/assets/images/vaxholm-day.svg',
      after: '/assets/images/vaxholm-twilight.svg',
      beforeLabel: '☁️ FÖRE: GRÅMULEN DAG',
      afterLabel: '🌅 EFTER: GOLDEN HOUR'
    },
    staging: {
      before: '/assets/images/empty-living.svg',
      after: '/assets/images/staged-living.svg',
      beforeLabel: '📦 FÖRE: TOMT RUM',
      afterLabel: '🛋️ EFTER: AI-HOMESTAGING'
    }
  };

  let isDragging = false;

  function setSliderPosition(percentage: number) {
    const clamped = Math.max(0, Math.min(100, percentage));
    if (beforeLayer) beforeLayer.style.width = `${clamped}%`;
    if (handle) handle.style.left = `${clamped}%`;
  }

  function handleMove(clientX: number) {
    if (!container) return;
    const rect = container.getBoundingClientRect();
    const x = clientX - rect.left;
    const percentage = (x / rect.width) * 100;
    setSliderPosition(percentage);
  }

  // Mouse Events
  container?.addEventListener('mousedown', (e) => {
    isDragging = true;
    dragHint?.classList.add('hidden');
    handleMove(e.clientX);
  });

  window.addEventListener('mousemove', (e) => {
    if (!isDragging) return;
    handleMove(e.clientX);
  });

  window.addEventListener('mouseup', () => {
    isDragging = false;
  });

  // Touch Events for Mobile
  container?.addEventListener('touchstart', (e) => {
    isDragging = true;
    dragHint?.classList.add('hidden');
    handleMove(e.touches[0].clientX);
  }, { passive: true });

  window.addEventListener('touchmove', (e) => {
    if (!isDragging) return;
    handleMove(e.touches[0].clientX);
  }, { passive: true });

  window.addEventListener('touchend', () => {
    isDragging = false;
  });

  // Preset switching
  presetTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      presetTabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');

      const presetKey = tab.getAttribute('data-preset') as keyof typeof presets;
      const data = presets[presetKey];

      if (data) {
        if (imgBefore) imgBefore.src = data.before;
        if (imgAfter) imgAfter.src = data.after;
        if (badgeBefore) badgeBefore.innerHTML = `<span>${data.beforeLabel}</span>`;
        if (badgeAfter) badgeAfter.innerHTML = `<span>${data.afterLabel}</span>`;
        
        // Reset slider to middle
        setSliderPosition(50);
      }
    });
  });

  // Initial position 50%
  setSliderPosition(50);
</script>

<style>
  .season-section {
    padding-top: var(--space-12);
    padding-bottom: var(--space-20);
    background: radial-gradient(circle at 50% 50%, rgba(245, 158, 11, 0.04) 0%, transparent 70%);
  }

  /* Preset Selector Tabs */
  .slider-preset-tabs {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
  }

  .preset-tab {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-5);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-base);
  }

  .preset-tab:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-heading);
    border-color: var(--border-medium);
  }

  .preset-tab.active {
    background: rgba(229, 179, 100, 0.15);
    color: var(--accent-gold);
    border-color: var(--accent-gold);
    box-shadow: 0 0 15px rgba(229, 179, 100, 0.2);
  }

  .preset-icon {
    font-size: 14px;
  }

  /* Slider Wrapper & Stage */
  .slider-wrapper {
    max-width: 1040px;
    margin: 0 auto;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .slider-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    user-select: none;
    cursor: ew-resize;
    overflow: hidden;
    background: #000;
  }

  .slider-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .layer-before {
    z-index: 2;
    width: 50%;
    border-right: 2px solid var(--accent-gold);
  }

  .slider-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  /* Fix for before layer: make image span full width of parent container even when layer is clipped */
  .layer-before .slider-img {
    width: 100%;
    max-width: none;
  }

  /* We use direct width styling on slider-container to keep images aligned */
  #slider-before-layer .slider-img {
    width: 1040px;
    max-width: 1040px;
  }

  @media (max-width: 1040px) {
    #slider-before-layer .slider-img {
      width: 100vw;
      max-width: 100vw;
    }
  }

  /* Labels */
  .layer-badge {
    position: absolute;
    top: var(--space-4);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.05em;
    backdrop-filter: blur(10px);
    z-index: 5;
    pointer-events: none;
  }

  .badge-before {
    left: var(--space-4);
    background: rgba(15, 23, 42, 0.85);
    color: var(--accent-winter);
    border: 1px solid rgba(96, 165, 250, 0.3);
  }

  .badge-after {
    right: var(--space-4);
    background: rgba(15, 23, 42, 0.85);
    color: var(--accent-gold);
    border: 1px solid rgba(229, 179, 100, 0.3);
  }

  /* Slider Handle */
  .slider-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 44px;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .handle-line {
    flex: 1;
    width: 2px;
    background: var(--accent-gold);
    box-shadow: 0 0 10px var(--accent-gold);
  }

  .handle-button {
    width: 44px;
    height: 44px;
    background: #090a0d;
    border: 2px solid var(--accent-gold);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-gold);
    box-shadow: 0 0 20px var(--accent-gold-glow), var(--shadow-md);
    transition: transform var(--transition-fast);
  }

  .slider-container:hover .handle-button {
    transform: scale(1.1);
  }

  /* Drag hint */
  .drag-hint {
    position: absolute;
    bottom: var(--space-4);
    left: 50%;
    transform: translateX(-50%);
    background: rgba(9, 10, 13, 0.8);
    backdrop-filter: blur(8px);
    border: 1px solid var(--border-subtle);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    color: var(--text-muted);
    pointer-events: none;
    z-index: 4;
    transition: opacity var(--transition-base);
  }

  .drag-hint.hidden {
    opacity: 0;
  }

  /* Slider Footer Features */
  .slider-footer-features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    padding: var(--space-6) var(--space-8);
    background: rgba(14, 16, 22, 0.95);
    border-top: 1px solid var(--border-subtle);
  }

  .sf-feature {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .sf-icon {
    font-size: 24px;
    line-height: 1;
  }

  .sf-title {
    font-size: var(--text-sm);
    color: var(--text-heading);
    margin-bottom: var(--space-1);
  }

  .sf-desc {
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .slider-footer-features {
      grid-template-columns: 1fr;
      gap: var(--space-4);
      padding: var(--space-5);
    }
  }
</style>
