---
import type { ServiceItem } from '../data/services';

interface Props {
  service: ServiceItem;
  featured?: boolean;
}

const { service, featured = false } = Astro.props;
---

<article class:list={['service-card', 'glass-panel', { featured }]} id={service.id}>
  <div class="card-header">
    <div class="card-icon-wrapper">
      {service.icon === 'video' && (
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
      )}
      {service.icon === 'sun' && (
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
      )}
      {service.icon === 'home' && (
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
      )}
    </div>
    <span class="service-badge">{service.badge}</span>
  </div>

  <h3 class="service-title">{service.title}</h3>
  <p class="service-desc">{service.shortDesc}</p>

  {service.fullDesc && (
    <div class="service-details">
      {service.fullDesc.map((p) => (
        <p class="detail-paragraph">{p}</p>
      ))}
    </div>
  )}

  <div class="service-features">
    <h4 class="features-title">Vad som ingår:</h4>
    <ul class="features-list">
      {service.features.map((feat) => (
        <li>
          <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span>{feat}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="card-footer">
    <a href="#kontakt" class="btn btn-secondary btn-sm" style="width: 100%;">
      Boka denna tjänst
    </a>
  </div>
</article>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-8);
    border-radius: var(--radius-xl);
    transition: all var(--transition-base);
    position: relative;
    overflow: hidden;
  }

  .service-card:hover {
    transform: translateY(-4px);
    border-color: rgba(229, 179, 100, 0.4);
    box-shadow: var(--shadow-glow);
  }

  .service-card.featured {
    border-color: rgba(229, 179, 100, 0.5);
    background: linear-gradient(180deg, rgba(24, 27, 35, 0.85) 0%, rgba(32, 28, 20, 0.4) 100%);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-6);
  }

  .card-icon-wrapper {
    width: 50px;
    height: 50px;
    border-radius: var(--radius-md);
    background: rgba(229, 179, 100, 0.1);
    color: var(--accent-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(229, 179, 100, 0.25);
  }

  .service-badge {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-gold);
    background: rgba(229, 179, 100, 0.08);
    padding: 4px 10px;
    border-radius: var(--radius-full);
    border: 1px solid rgba(229, 179, 100, 0.2);
  }

  .service-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-3);
    color: var(--text-heading);
  }

  .service-desc {
    font-size: var(--text-base);
    color: var(--text-muted);
    margin-bottom: var(--space-5);
    line-height: 1.6;
  }

  .service-details {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-4);
  }

  .detail-paragraph {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .service-features {
    margin-top: auto;
    margin-bottom: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
  }

  .features-title {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-subtle);
    margin-bottom: var(--space-3);
  }

  .features-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .features-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-main);
  }

  .check-icon {
    color: var(--accent-gold);
    flex-shrink: 0;
    margin-top: 3px;
  }

  .card-footer {
    margin-top: var(--space-4);
  }
</style>
