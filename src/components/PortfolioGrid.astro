---
import { portfolioItems } from '../data/portfolioItems';
---

<section class="portfolio-section">
  <div class="container">
    <div class="section-header">
      <div class="section-badge">
        <span>Showcase &amp; Referenser</span>
      </div>
      <h1 class="section-title">
        Vårt <span class="gradient-text">Portfolio</span>
      </h1>
      <p class="section-subtitle">
        Utforska exempel på hur vi förvandlar stillbilder till dynamiska videorundturer, byter årstider och stylar bostäder digitalt för Sveriges ledande mäklare.
      </p>
    </div>

    <!-- Filter Buttons -->
    <div class="portfolio-filters">
      <button class="filter-btn active" data-filter="all">Alla Case ({portfolioItems.length})</button>
      <button class="filter-btn" data-filter="video">Videorundturer</button>
      <button class="filter-btn" data-filter="season">Säsongs- &amp; Miljöbyte</button>
      <button class="filter-btn" data-filter="staging">Virtuell Homestaging</button>
    </div>

    <!-- Portfolio Grid -->
    <div class="portfolio-grid" id="portfolio-grid">
      {portfolioItems.map((item) => (
        <article 
          class="portfolio-card glass-panel" 
          data-category={item.category}
          id={`case-${item.id}`}
        >
          <div class="card-media-wrapper" data-item-id={item.id}>
            <!-- Before Image -->
            <img 
              src={item.beforeImage} 
              alt={`Före: ${item.title}`} 
              class="media-img media-before"
            />
            <!-- After Image -->
            <img 
              src={item.afterImage} 
              alt={`Efter: ${item.title}`} 
              class="media-img media-after active"
            />

            <!-- Interactive Quick Toggle Indicator -->
            <div class="card-media-controls">
              <button class="media-toggle-btn active" data-view="after">Efter (AI)</button>
              <button class="media-toggle-btn" data-view="before">Före (Foto)</button>
            </div>

            <span class="category-tag">{item.categoryLabel}</span>
          </div>

          <div class="card-content">
            <div class="card-meta">
              <span class="prop-type">{item.propertyType}</span>
            </div>
            <h3 class="card-title">{item.title}</h3>
            <p class="card-description">{item.description}</p>

            <div class="card-tags">
              {item.tags.map((tag) => (
                <span class="tag-pill">{tag}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Bottom CTA -->
    <div class="portfolio-cta-banner glass-panel">
      <div class="cta-banner-text">
        <h3 class="banner-title">Har ni ett objekt ni vill testa med?</h3>
        <p class="banner-desc">Skicka över era mäklarbilder så sätter vi ihop ett kostnadsfritt testprov.</p>
      </div>
      <a href="/tjanster#kontakt" class="btn btn-primary btn-lg">
        Boka gratis testprov
      </a>
    </div>
  </div>
</section>

<script>
  // Filter functionality
  const filterBtns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.portfolio-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      const filter = btn.getAttribute('data-filter');

      cards.forEach((card) => {
        const cat = card.getAttribute('data-category');
        if (filter === 'all' || filter === cat) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  // Per-card before/after toggle buttons
  const mediaWrappers = document.querySelectorAll('.card-media-wrapper');

  mediaWrappers.forEach((wrapper) => {
    const toggleBtns = wrapper.querySelectorAll('.media-toggle-btn');
    const imgBefore = wrapper.querySelector('.media-before');
    const imgAfter = wrapper.querySelector('.media-after');

    toggleBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const view = btn.getAttribute('data-view');
        if (view === 'before') {
          imgBefore?.classList.add('active');
          imgAfter?.classList.remove('active');
        } else {
          imgAfter?.classList.add('active');
          imgBefore?.classList.remove('active');
        }
      });
    });
  });
</script>

<style>
  .portfolio-section {
    padding-top: var(--space-12);
    padding-bottom: var(--space-20);
  }

  .portfolio-filters {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    margin-bottom: var(--space-12);
    flex-wrap: wrap;
  }

  .filter-btn {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    padding: var(--space-2) var(--space-5);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-base);
  }

  .filter-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-heading);
    border-color: var(--border-medium);
  }

  .filter-btn.active {
    background: rgba(229, 179, 100, 0.15);
    color: var(--accent-gold);
    border-color: var(--accent-gold);
    box-shadow: 0 0 15px rgba(229, 179, 100, 0.2);
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-8);
  }

  .portfolio-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition: all var(--transition-base);
  }

  .portfolio-card:hover {
    transform: translateY(-4px);
    border-color: rgba(229, 179, 100, 0.35);
    box-shadow: var(--shadow-md);
  }

  /* Media Wrapper */
  .card-media-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    overflow: hidden;
  }

  .media-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--transition-base);
    pointer-events: none;
  }

  .media-img.active {
    opacity: 1;
    pointer-events: auto;
  }

  .category-tag {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(8px);
    color: var(--accent-gold);
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 3px 10px;
    border-radius: var(--radius-full);
    border: 1px solid rgba(229, 179, 100, 0.3);
  }

  .card-media-controls {
    position: absolute;
    bottom: var(--space-3);
    right: var(--space-3);
    display: flex;
    background: rgba(9, 10, 13, 0.85);
    backdrop-filter: blur(8px);
    padding: 2px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    z-index: 5;
  }

  .media-toggle-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 3px 10px;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .media-toggle-btn.active {
    background: var(--accent-gold);
    color: #090a0d;
  }

  /* Card Content */
  .card-content {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-meta {
    margin-bottom: var(--space-2);
  }

  .prop-type {
    font-size: var(--text-xs);
    color: var(--text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .card-title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
    color: var(--text-heading);
  }

  .card-description {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-5);
  }

  .card-tags {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag-pill {
    font-size: var(--text-xs);
    padding: 2px 8px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
  }

  /* Bottom CTA Banner */
  .portfolio-cta-banner {
    margin-top: var(--space-16);
    padding: var(--space-8) var(--space-10);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    border-radius: var(--radius-xl);
    border: 1px solid rgba(229, 179, 100, 0.3);
    background: linear-gradient(135deg, rgba(24, 27, 35, 0.9) 0%, rgba(32, 28, 20, 0.6) 100%);
  }

  .banner-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-2);
    color: var(--text-heading);
  }

  .banner-desc {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  @media (max-width: 860px) {
    .portfolio-grid {
      grid-template-columns: 1fr;
    }

    .portfolio-cta-banner {
      flex-direction: column;
      text-align: center;
      padding: var(--space-6);
    }
  }
</style>
